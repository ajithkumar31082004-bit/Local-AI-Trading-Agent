# Local AI Trading Agent Environment Configuration

# Ollama Local LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=60

# Trading Account Configuration (Paper Trading Only)
PAPER_TRADING_ENABLED=true
DEFAULT_STARTING_BALANCE=100000.0
CURRENCY=USD

# Risk Management Limits
MAX_RISK_PER_TRADE_PCT=2.0
MAX_POSITION_ALLOCATION_PCT=20.0
MAX_DAILY_LOSS_PCT=5.0
MAX_OPEN_POSITIONS=5
DEFAULT_STOP_LOSS_PCT=2.5
DEFAULT_TAKE_PROFIT_PCT=5.0

# Trading Costs & Execution Defaults
TRANSACTION_FEE_PCT=0.1
DEFAULT_SLIPPAGE_PCT=0.05

# Database Configuration
DATABASE_PATH=data/trading_agent.db

# Market Data Settings
DATA_CACHE_EXPIRY_MINUTES=5
DEFAULT_SYMBOL=AAPL

# Supabase Cloud Database Configuration
SUPABASE_ENABLED=true
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_KEY=<your-anon-or-service-key>
SUPABASE_SECRET=<your-supabase-secret>

# Delta Exchange API Configuration (Optional)
DELTA_EXCHANGE_ENABLED=false
DELTA_EXCHANGE_BASE_URL=https://india.delta.exchange
DELTA_EXCHANGE_API_KEY=<your-delta-api-key>
DELTA_EXCHANGE_API_SECRET=<your-delta-api-secret>
