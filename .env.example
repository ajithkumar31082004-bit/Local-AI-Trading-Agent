# Local AI Trading Agent Environment Configuration

# Ollama Local LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=60

# Trading Account Configuration (Paper Trading Only)
PAPER_TRADING_ENABLED=true
DEFAULT_STARTING_BALANCE=100000.0
CURRENCY=USD

# Risk Management Limits
MAX_RISK_PER_TRADE_PCT=2.0
MAX_POSITION_ALLOCATION_PCT=20.0
MAX_DAILY_LOSS_PCT=5.0
MAX_OPEN_POSITIONS=5
DEFAULT_STOP_LOSS_PCT=2.5
DEFAULT_TAKE_PROFIT_PCT=5.0

# Trading Costs & Execution Defaults
TRANSACTION_FEE_PCT=0.1
DEFAULT_SLIPPAGE_PCT=0.05

# Database Configuration
DATABASE_PATH=data/trading_agent.db

# Market Data Settings
DATA_CACHE_EXPIRY_MINUTES=5
DEFAULT_SYMBOL=AAPL

# Supabase Cloud Database Configuration
SUPABASE_ENABLED=true
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_KEY=<your-anon-or-service-key>
SUPABASE_SECRET=<your-supabase-secret>

# Trading Execution Mode & Safety Controls
# Mode options: PAPER (simulated only), ALERT_ONLY (signals only), LIVE (real order submission)
TRADING_MODE=PAPER
# Secondary safety confirmation switch required ONLY if TRADING_MODE=LIVE (must be 'YES')
LIVE_TRADING_ACKNOWLEDGED=NO
# Emergency Kill Switch: Set to 'true' to instantly block all new trade entries
EMERGENCY_KILL_SWITCH=false

# Delta Exchange India API Configuration
# For account telemetry & market data only, create a READ-ONLY API key.
# For live order execution (TRADING_MODE=LIVE), a Trading-permission key is required.
DELTA_EXCHANGE_ENABLED=false
DELTA_EXCHANGE_BASE_URL=https://api.india.delta.exchange
DELTA_EXCHANGE_API_KEY=<your-delta-api-key>
DELTA_EXCHANGE_API_SECRET=<your-delta-api-secret>

# NewsAPI Configuration (Optional Financial News Feed)
NEWSAPI_KEY=<your-newsapi-key>

# Alpha Vantage API Configuration (Optional Alternative Market Data Feed)
ALPHA_VANTAGE_API_KEY=<your-alphavantage-key>


# XAUTUSD ORB + EMA20 + Volume (public market data; no API keys required)
ORB_SYMBOL=XAUTUSD
ORB_MODE=PAPER
ORB_TIMEZONE=Asia/Kolkata
ORB_SESSION_START=09:00
ORB_MINUTES=15
ORB_EMA_PERIOD=20
ORB_VOLUME_PERIOD=20
ORB_MAX_EMA_CROSSES=2
ORB_MAX_EXTENSION_ATR=1.0
ORB_ATR_PERIOD=14
ORB_RETEST_TOLERANCE=0.15
ORB_REJECTION_WICK_BODY_RATIO=1.0
ORB_MAX_BARS_AFTER_BREAKOUT=12
ORB_STOP_BUFFER=0.05
ORB_TARGET_R=2.0
ORB_MAX_RISK_PCT=0.5
ORB_DAILY_LOSS_LIMIT_PCT=1.5
ORB_MAX_TRADES_PER_DAY=1
ORB_LOSS_COOLDOWN_MINUTES=60
ORB_CONTRACT_SIZE_XAUT=0.001
ORB_LOT_INCREMENT=1
ORB_LEVERAGE=2
ORB_FEE_PCT_PER_SIDE=0.01
ORB_SPREAD_PCT_ROUND_TRIP=0.02
ORB_SLIPPAGE_PCT_ROUND_TRIP=0.02
ORB_MAX_MARGIN_PCT_EQUITY=10
ORB_DELTA_API_BASE_URL=https://api.india.delta.exchange
